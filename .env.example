# Copy to .env.local and fill in. .env.local is gitignored - never commit real values.
#
# IMPORTANT: Vite inlines every VITE_-prefixed variable into the client bundle,
# so everything here is PUBLIC and readable by anyone. Only put a form provider's
# public form id / access key here. Never a private API key or SMTP credential.

# --- Option A: Formspree -----------------------------------------------------
# The form id is in the URL. No access key needed.
# VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# --- Option B: Web3Forms -----------------------------------------------------
# Endpoint is fixed; the access key is the public key mailed to you on signup.
# VITE_FORM_ENDPOINT=https://api.web3forms.com/submit
# VITE_FORM_ACCESS_KEY=00000000-0000-0000-0000-000000000000

VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=
