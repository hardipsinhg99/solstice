# Solstice admin CMS API - copy to .env and fill in. .env is gitignored.
# Never commit real secrets. Note: these are SERVER-side only and must never be
# given a VITE_ prefix - Vite inlines VITE_* into the public browser bundle.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/solstice_cms?schema=public"

# Sign the admin JWT. Use a long random value, e.g. `openssl rand -base64 48`.
JWT_SECRET="change-me"
JWT_EXPIRES_IN="8h"

# The single admin is created by `npm run seed` if no admin row exists.
ADMIN_SEED_EMAIL="admin@solsticetrading.com"
ADMIN_SEED_PASSWORD="change-me-before-seeding"

# Comma-separated allowlist. Never "*" - the API issues credentials.
CORS_ORIGIN="http://localhost:5173"

# Where LocalDiskStorageService writes. Relative paths resolve from server/.
# Gitignored. See docs/admin.md for the durability caveat on a non-containerised
# API: these files survive an API restart but NOT a fresh deploy or a second
# instance behind a load balancer.
UPLOAD_DIR="uploads"
UPLOAD_PUBLIC_PREFIX="/api/uploads"

PORT=3001

# ── Enquiry notification (SMTP) ───────────────────────────────────────────────
# Optional. If SMTP_HOST is unset, enquiries are still saved and shown in the
# admin - only the email notification is skipped, and the API logs a warning at
# boot. It is never allowed to fail a submission.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Solstice website <no-reply@solsticetrading.com>"
# Where new-enquiry notifications land. Usually the same inbox as the site's
# public enquiry address.
NOTIFY_EMAIL="hello@solsticetrading.com"
