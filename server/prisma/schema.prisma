// Solstice admin CMS - Phase 1a schema (Products only).
// Pages, PageSection and Enquiry are designed in docs/admin-cms-blueprint.md but
// deliberately not created here: both are blocked on open questions the client
// has not answered, and an unused table is a migration to undo later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TradeDirection {
  EXPORT
  IMPORT
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

// Incoterms are aspirational - no product carries one today. Modelled as an enum
// rather than free text so the value set cannot drift once data does arrive.
enum Incoterm {
  EXW
  FOB
  CFR
  CIF
  DAP
  DDP
}

/// Single admin. No role column by design (docs/admin-cms-blueprint.md §2):
/// Solstice is ~10 people with one operator. The updatedById back-references
/// below are captured from day one so roles can be introduced later without a
/// data migration - backfilling who-did-what is the expensive part of RBAC.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  products       Product[]
  varieties      ProductVariety[]
  packOptions    ProductPackOption[]
  certifications ProductCertification[]
  auditEntries   AuditLog[]
  mediaAssets    MediaAsset[]

  @@map("admins")
}

/// Where the bytes for a MediaAsset actually live. LOCAL assets are files this
/// server wrote through StorageService and can delete. EXTERNAL assets are URLs
/// we only reference - the six seeded Unsplash photographs - and StorageService
/// must never try to delete them. Adding S3 later is one more value here plus
/// one more StorageService implementation, not a schema change.
enum StorageDriver {
  LOCAL
  EXTERNAL
}

/// One media system, deliberately generic. Products are its only consumer this
/// phase, but Pages and TipTap in Phase 2 reuse this table and this pipeline
/// rather than growing a second one - the failure the PRIM AI audit found, where
/// SiteSetting, PageContent and localStorage all did overlapping jobs because
/// nobody built one system first.
model MediaAsset {
  id          String        @id @default(cuid())
  /// Original upload name, kept for display only. Never used as a storage path.
  filename    String
  /// Opaque key the StorageService understands. Nothing outside a StorageService
  /// implementation may interpret this as a filesystem path.
  storagePath String
  driver      StorageDriver @default(LOCAL)
  url         String
  mimeType    String
  width       Int
  height      Int
  sizeBytes   Int
  /// First-class, not an afterthought: the public <img alt=""> renders this.
  altText     String?

  uploadedById String?
  uploadedBy   Admin?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  primaryFor   Product[]      @relation("ProductPrimaryImage")
  productMedia ProductMedia[]

  @@map("media_assets")
}

/// Ordered gallery join. Separate from Product.primaryImageId so a product can
/// have a hero image and an ordered set of secondary images independently.
model ProductMedia {
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  mediaAssetId String
  order        Int        @default(0)

  @@id([productId, mediaAssetId])
  @@index([productId, order])
  @@map("product_media")
}

model Product {
  id     String         @id @default(cuid())
  slug   String         @unique
  name   String
  trade  TradeDirection @default(EXPORT)
  status ProductStatus  @default(DRAFT)

  // The fields that carry real data today. The imagery moved to MediaAsset in
  // Phase 1b; primaryImageId is nullable for the same reason the old `image`
  // column was - the two import placeholder records genuinely have no picture.
  type        String
  description String  @db.Text

  /// Replaces the old `image String?`. The six seeded Unsplash URLs were migrated
  /// into MediaAsset rows with driver EXTERNAL, so nothing was lost.
  primaryImageId String?
  primaryImage   MediaAsset? @relation("ProductPrimaryImage", fields: [primaryImageId], references: [id], onDelete: SetNull)
  gallery        ProductMedia[]
  season      String
  origin      String
  packaging   String

  /// Marks the "awaiting details" import slots. Kept because ProductCard renders
  /// a distinct placeholder card off it; dropping the flag would silently turn
  /// two stubs into apparently-real products.
  placeholder Boolean @default(false)

  // ── Aspirational commercial spec ────────────────────────────────────────────
  // Every one of these is nullable / empty-by-default. No product has any of
  // them yet, and requiring data nobody has would block product creation.
  hsCode         String?
  incoterms      Incoterm[]
  moqValue       Decimal?   @db.Decimal(10, 2)
  moqUnit        String?
  shelfLifeDays  Int?
  storageTempC   String?
  storageHumidity String?
  portsOfLoading String[]

  seoTitle       String?
  seoDescription String?

  varieties      ProductVariety[]
  packOptions    ProductPackOption[]
  certifications ProductCertification[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   Admin?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([trade, status])
  @@map("products")
}

/// Child table, not a JSON array on Product - per the blueprint: varieties must
/// be filterable independently ("everything FOB Mundra in 4kg cartons"), which a
/// JSON blob does not support cleanly.
model ProductVariety {
  id         String  @id @default(cuid())
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  name       String
  grade      String?
  calibreMin Int?
  calibreMax Int?
  order      Int     @default(0)

  updatedById String?
  updatedBy   Admin?  @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([productId, order])
  @@map("product_varieties")
}

model ProductPackOption {
  id               String  @id @default(cuid())
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  cartonWeightKg   Decimal @db.Decimal(6, 2)
  cartonsPerPallet Int?
  palletsPerReefer Int?
  cartonsPerReefer Int?
  notes            String?
  order            Int     @default(0)

  updatedById String?
  updatedBy   Admin?  @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([productId, order])
  @@map("product_pack_options")
}

/// `verifiable` is not cosmetic. docs/website-strategy.md records that claiming a
/// certification without a producible certificate reference is a legal exposure
/// in several destination markets. The admin UI puts an explicit confirmation in
/// front of setting it true, and renders unverified claims in a warning state.
model ProductCertification {
  id         String  @id @default(cuid())
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  name       String
  verifiable Boolean @default(false)
  reference  String?
  order      Int     @default(0)

  updatedById String?
  updatedBy   Admin?  @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([productId, order])
  @@map("product_certifications")
}

/// Lightweight audit trail - answers "who changed the Alphonso MOQ last Tuesday".
/// Deliberately not an enterprise audit system: no tamper-proofing, no retention.
model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  actor      Admin?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  summary    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("audit_log")
}
