// Solstice admin CMS - Phase 1a schema (Products only).
// Pages, PageSection and Enquiry are designed in docs/admin-cms-blueprint.md but
// deliberately not created here: both are blocked on open questions the client
// has not answered, and an unused table is a migration to undo later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TradeDirection {
  EXPORT
  IMPORT
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

// Incoterms are aspirational - no product carries one today. Modelled as an enum
// rather than free text so the value set cannot drift once data does arrive.
enum Incoterm {
  EXW
  FOB
  CFR
  CIF
  DAP
  DDP
}

/// Single admin. No role column by design (docs/admin-cms-blueprint.md §2):
/// Solstice is ~10 people with one operator. The updatedById back-references
/// below are captured from day one so roles can be introduced later without a
/// data migration - backfilling who-did-what is the expensive part of RBAC.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  products       Product[]
  varieties      ProductVariety[]
  packOptions    ProductPackOption[]
  certifications ProductCertification[]
  auditEntries   AuditLog[]
  mediaAssets    MediaAsset[]
  settingsEdits  SiteSettings[]
  galleryEdits   GalleryImage[]
  pageEdits      Page[]
  sectionEdits   PageSection[]
  teamEdits      TeamMember[]

  @@map("admins")
}

/// Where the bytes for a MediaAsset actually live. LOCAL assets are files this
/// server wrote through StorageService and can delete. EXTERNAL assets are URLs
/// we only reference - the six seeded Unsplash photographs - and StorageService
/// must never try to delete them. Adding S3 later is one more value here plus
/// one more StorageService implementation, not a schema change.
enum StorageDriver {
  LOCAL
  EXTERNAL
}

/// One media system, deliberately generic. Products are its only consumer this
/// phase, but Pages and TipTap in Phase 2 reuse this table and this pipeline
/// rather than growing a second one - the failure the PRIM AI audit found, where
/// SiteSetting, PageContent and localStorage all did overlapping jobs because
/// nobody built one system first.
model MediaAsset {
  id          String        @id @default(cuid())
  /// Original upload name, kept for display only. Never used as a storage path.
  filename    String
  /// Opaque key the StorageService understands. Nothing outside a StorageService
  /// implementation may interpret this as a filesystem path.
  storagePath String
  driver      StorageDriver @default(LOCAL)
  url         String
  mimeType    String
  width       Int
  height      Int
  sizeBytes   Int
  /// First-class, not an afterthought: the public <img alt=""> renders this.
  altText     String?

  uploadedById String?
  uploadedBy   Admin?  @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  primaryFor   Product[]      @relation("ProductPrimaryImage")
  productMedia ProductMedia[]
  galleryUse   GalleryImage[]
  teamPhotoFor TeamMember[]

  @@map("media_assets")
}

/// Ordered gallery join. Separate from Product.primaryImageId so a product can
/// have a hero image and an ordered set of secondary images independently.
model ProductMedia {
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  mediaAssetId String
  order        Int        @default(0)

  @@id([productId, mediaAssetId])
  @@index([productId, order])
  @@map("product_media")
}

model Product {
  id     String         @id @default(cuid())
  slug   String         @unique
  name   String
  trade  TradeDirection @default(EXPORT)
  status ProductStatus  @default(DRAFT)

  // The fields that carry real data today. The imagery moved to MediaAsset in
  // Phase 1b; primaryImageId is nullable for the same reason the old `image`
  // column was - the two import placeholder records genuinely have no picture.
  type        String
  description String  @db.Text

  /// Replaces the old `image String?`. The six seeded Unsplash URLs were migrated
  /// into MediaAsset rows with driver EXTERNAL, so nothing was lost.
  primaryImageId String?
  primaryImage   MediaAsset? @relation("ProductPrimaryImage", fields: [primaryImageId], references: [id], onDelete: SetNull)
  gallery        ProductMedia[]
  season      String
  origin      String
  packaging   String

  /// Marks the "awaiting details" import slots. Kept because ProductCard renders
  /// a distinct placeholder card off it; dropping the flag would silently turn
  /// two stubs into apparently-real products.
  placeholder Boolean @default(false)

  // ── Aspirational commercial spec ────────────────────────────────────────────
  // Every one of these is nullable / empty-by-default. No product has any of
  // them yet, and requiring data nobody has would block product creation.
  hsCode         String?
  incoterms      Incoterm[]
  moqValue       Decimal?   @db.Decimal(10, 2)
  moqUnit        String?
  shelfLifeDays  Int?
  storageTempC   String?
  storageHumidity String?
  portsOfLoading String[]

  seoTitle       String?
  seoDescription String?

  varieties      ProductVariety[]
  packOptions    ProductPackOption[]
  certifications ProductCertification[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   Admin?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([trade, status])
  @@map("products")
}

/// Child table, not a JSON array on Product - per the blueprint: varieties must
/// be filterable independently ("everything FOB Mundra in 4kg cartons"), which a
/// JSON blob does not support cleanly.
model ProductVariety {
  id         String  @id @default(cuid())
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  name       String
  grade      String?
  calibreMin Int?
  calibreMax Int?
  order      Int     @default(0)

  updatedById String?
  updatedBy   Admin?  @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([productId, order])
  @@map("product_varieties")
}

model ProductPackOption {
  id               String  @id @default(cuid())
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId        String
  cartonWeightKg   Decimal @db.Decimal(6, 2)
  cartonsPerPallet Int?
  palletsPerReefer Int?
  cartonsPerReefer Int?
  notes            String?
  order            Int     @default(0)

  updatedById String?
  updatedBy   Admin?  @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([productId, order])
  @@map("product_pack_options")
}

/// `verifiable` is not cosmetic. docs/website-strategy.md records that claiming a
/// certification without a producible certificate reference is a legal exposure
/// in several destination markets. The admin UI puts an explicit confirmation in
/// front of setting it true, and renders unverified claims in a warning state.
model ProductCertification {
  id         String  @id @default(cuid())
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  name       String
  verifiable Boolean @default(false)
  reference  String?
  order      Int     @default(0)

  updatedById String?
  updatedBy   Admin?  @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([productId, order])
  @@map("product_certifications")
}

/// Editable marketing pages, keyed by the route slug the hash router already
/// uses - 'home', 'about', 'team'. Slug-keyed and generic on purpose: adding
/// Services, Privacy or Terms later is a seed row and a section config, not a
/// schema change. Only the three this phase covers are seeded.
///
/// This is the FIXED TYPED SECTIONS model from docs/admin-cms-blueprint.md, not
/// freeform blocks: a section's `type` selects a known field set that a real
/// React component already consumes. An editor cannot invent a section the site
/// has no component for, which is the whole argument the blueprint made against
/// drag-and-drop page building.
model Page {
  id     String        @id @default(cuid())
  slug   String        @unique
  title  String
  status ProductStatus @default(DRAFT)

  /// Reusing ProductStatus rather than declaring an identical second enum. The
  /// two states and their meaning are the same, and a PageStatus{DRAFT,PUBLISHED}
  /// would be duplication for the sake of a nicer name.
  publishedAt DateTime?

  sections PageSection[]

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   Admin?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("pages")
}

/// One section of one page.
///
/// draftData and publishedData are the reason this is not just a JSON blob on
/// Page. Product's model - one status flag, edits to a published row go live
/// instantly - cannot express "save this wording but do not ship it yet", and
/// that is exactly what an editor needs on a marketing page. The public site
/// reads publishedData and nothing else; the admin edits draftData; Publish
/// copies one onto the other.
///
/// `data` is Json rather than columns because the shape genuinely differs per
/// section type - a repeater of four differentiator cards and a two-CTA hero
/// have nothing in common. The TYPE is the contract, enforced by the field
/// config in src/features/pages/sectionTypes.js and by the component that
/// renders it; the JSON is just its storage.
model PageSection {
  id     String @id @default(cuid())
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId String
  /// Stable identifier used by the public component to find its own content.
  /// Never reordered into meaning - `order` is presentation, `key` is identity.
  key    String
  type   String
  order  Int    @default(0)

  draftData     Json
  publishedData Json?

  /// Section-level visibility, split into a draft and a published value for
  /// exactly the same reason the payload is: hiding a section is content, so it
  /// has to travel through save -> publish like every other edit. A single
  /// `visible` column would have been the one control in the CMS that changed
  /// the live site the instant it was clicked, and Phase 1e's rule is that an
  /// editor can always answer "is this live?".
  ///
  /// Both default to true. A migration defaulting to false would have hidden
  /// every section of every page the moment it ran.
  draftVisible     Boolean @default(true)
  publishedVisible Boolean @default(true)

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   Admin?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([pageId, key])
  @@index([pageId, order])
  @@map("page_sections")
}

/// A real person on the Team page.
///
/// Its own model, not section JSON, because it needs the same things
/// GalleryImage needs: individual CRUD, ordering, and a photo through the media
/// pipeline. Burying that in a JSON array would mean hand-rolling all three.
///
/// `name` did not exist before this phase. The live page renders three
/// ANONYMOUS role cards - the array was [role, copy, image] - each illustrated
/// with a stock photograph of a stranger. website-strategy.md 2.5 calls that a
/// falsifiable trust claim, and it is the longest-standing flag in the audit.
model TeamMember {
  id   String @id @default(cuid())
  name String
  role String
  /// Rich text (TipTap HTML), sanitized server-side against an explicit tag
  /// allowlist before it is stored - see common/sanitize.ts.
  bio  String? @db.Text

  photoId String?
  photo   MediaAsset? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  order     Int     @default(0)
  published Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   Admin?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([published, order])
  @@map("team_members")
}

/// The public #gallery page, which until now was six Unsplash URLs hardcoded at
/// module scope in GalleryPage.jsx.
///
/// A join onto MediaAsset rather than a url column, so gallery images go through
/// the same upload pipeline as product images - magic-byte validation, sharp
/// re-encode, EXIF stripped, StorageService for the bytes. Adding a second way
/// to get a file onto this server is the thing the media module exists to
/// prevent.
///
/// `caption` is nullable and separate from MediaAsset.altText. They answer
/// different questions: altText is what a screen reader hears in place of the
/// image, caption is the visible line a sighted visitor reads underneath. A
/// gallery of harvest photographs wants both, and conflating them produces
/// captions that read like alt text.
model GalleryImage {
  id           String     @id @default(cuid())
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  mediaAssetId String
  caption      String?
  order        Int        @default(0)
  /// Unpublished images stay in the admin but never reach the public page - the
  /// same DRAFT/PUBLISHED escape hatch Product has, for a photograph that is
  /// uploaded but not cleared for use yet.
  published    Boolean    @default(true)

  updatedById String?
  updatedBy   Admin?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([published, order])
  @@map("gallery_images")
}

/// Global site settings. ONE ROW, id "singleton".
///
/// Named columns, not a generic settings(key, value) table. The key/value shape
/// needs no migration to add a setting, and that is exactly how the PRIM AI panel
/// ended up with a hundred-plus ungrouped free-text rows the server could not
/// validate. Named columns let the API check that whatsappNumber is a WhatsApp
/// number and let the form label it in the operator's language. One migration per
/// new setting is the cheaper side of that trade at this site's rate of change.
///
/// There is no contactPhone and no address: no phone number, postal address or
/// social link exists anywhere in the codebase today, and columns invented ahead
/// of the content that fills them are how a table ends up mostly null.
model SiteSettings {
  id String @id @default("singleton")

  /// Digits only, international format - validated against the same regex the
  /// admin form uses. wa.me silently resolves a malformed number to "phone number
  /// shared via url is invalid", so the failure only shows on a buyer's screen.
  whatsappNumber  String
  whatsappMessage String
  contactEmail    String

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   Admin?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

/// Submissions from the public contact form.
///
/// The columns are exactly the fields the live form collects. The richer RFQ
/// schema in docs/website-strategy.md - product context, quantity, destination
/// port, Incoterm - is NOT modelled: the form does not collect it, and adding
/// columns ahead of the fields that fill them is how a table ends up 80% null.
model Enquiry {
  id      String        @id @default(cuid())
  name    String
  email   String
  phone   String
  message String        @db.Text
  status  EnquiryStatus @default(NEW)

  /// Proof-of-consent timestamp. The form requires the checkbox, so recording
  /// when it was given costs one column and answers the only question a data
  /// request actually asks.
  consentAt DateTime?

  /// Set when the notification email was accepted by the SMTP server. Null means
  /// nobody was told - which is the state worth being able to find.
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@map("enquiries")
}

/// Lightweight audit trail - answers "who changed the Alphonso MOQ last Tuesday".
/// Deliberately not an enterprise audit system: no tamper-proofing, no retention.
model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  actor      Admin?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  summary    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@map("audit_log")
}
